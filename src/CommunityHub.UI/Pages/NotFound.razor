@page "/not-found"
@layout MainLayout

<PageTitle>No encontrado · CommunityHub</PageTitle>

<section class="pagina-no-encontrada" aria-labelledby="titulo-no-encontrado">
    <div class="panel-no-encontrado">
        <div class="mensaje">
            <p class="codigo-error">Error 404</p>

            <h1 id="titulo-no-encontrado">No encontrado</h1>

            <p>Lo que buscas no existe (todavía).</p>

            <p class="ayuda">
                Puedes volver a los retos y seguir participando con la comunidad.
            </p>

            <a class="btn btn-primary volver-retos" href="/retos">
                Volver a los retos
            </a>
        </div>

        <div class="ilustracion" aria-hidden="true">
            <span>{</span>

            <svg width="42"
                 height="42"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.5"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 focusable="false">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5" />
                <path d="M14 2v6h6" />
                <circle cx="16" cy="8" r="4" />
                <path d="m19 11 3 3" />
            </svg>

            <span>}</span>
        </div>
    </div>
</section>
